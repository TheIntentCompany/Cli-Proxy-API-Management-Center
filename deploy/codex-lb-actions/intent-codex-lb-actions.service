[Unit]
Description=codex-lb account actions for the CLIProxyAPI panel (127.0.0.1:8336)
After=network-online.target intent-codex-lb.service intent-codex-lb-status.service
Wants=network-online.target

[Service]
Type=simple
# A throwaway user: this relay never touches codex-lb's files, only its loopback API.
DynamicUser=yes
# The codex-lb dashboard login (username line, password line), root-owned 0600 on disk and
# handed to this unit only, through $CREDENTIALS_DIRECTORY.
LoadCredential=codex-lb-login:/etc/intent-codex-lb-actions/codex-lb-login
ExecStart=/usr/bin/python3 -I /opt/intent-codex-lb-actions/codex_lb_actions.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=96M
TasksMax=16
CPUQuota=25%

[Install]
WantedBy=multi-user.target
