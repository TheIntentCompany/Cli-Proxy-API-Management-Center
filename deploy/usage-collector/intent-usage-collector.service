[Unit]
Description=CLIProxyAPI usage history (127.0.0.1:8337)
After=network-online.target intent-codex-lb.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 -I /opt/intent-usage-collector/usage_collector.py
StateDirectory=intent-usage
StateDirectoryMode=0700
LoadCredential=management-key:/var/lib/cliproxy/secrets/management-key
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/intent-lb/codex
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=256M
TasksMax=32
CPUQuota=25%

[Install]
WantedBy=multi-user.target
